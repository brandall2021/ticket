# Base de datos
DATABASE_URL="postgresql://user:pass@host:5432/helpdesk?schema=public"

# Autenticación
AUTH_SECRET="generar con openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (opcional)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Cron (requerido para /api/admin/monitor/cron y /api/admin/mikrotik/cron)
# Debe coincidir con el Authorization: Bearer que envia el programador
CRON_SECRET="generar con openssl rand -base64 32"

# Cifrado de credenciales MikroTik (mínimo 32 caracteres; no cambiar tras guardar datos)
MIKROTIK_ENCRYPTION_KEY="generar con openssl rand -base64 32"
# Minutos antes de repetir una alerta persistente de CPU, memoria o interfaz
MIKROTIK_ALERT_COOLDOWN_MINUTES="60"

# SMTP (opcional)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@helpdesk.com"

# Acceso a servidores (SSH / RDP)
# Clave para cifrar las credenciales de los servidores (mínimo 32 caracteres).
# Si se deja vacía se reutiliza MIKROTIK_ENCRYPTION_KEY.
SERVER_ENCRYPTION_KEY="generar con openssl rand -base64 32"

# Gateway Apache Guacamole para RDP en el navegador (opcional).
# Sin estas variables, el acceso RDP ofrece descargar un archivo .rdp.
GUACAMOLE_URL="http://guacamole:8080/guacamole"
GUACAMOLE_PUBLIC_URL="/guacamole"
GUACAMOLE_USER="guacadmin"
GUACAMOLE_PASSWORD="guacadmin"
GUACAMOLE_DATA_SOURCE="default"

